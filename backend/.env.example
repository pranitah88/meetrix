PORT=5000

# Database Connection:
# Leave blank to run with zero-setup in-memory MongoDB (resets on process restart).
# Set to MongoDB Atlas or local MongoDB for persistent storage:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/meetrix?retryWrites=true&w=majority
MONGO_URI=

# Security:
# Replace with a cryptographically secure random string before deploying to production.
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# CORS allowed frontend origin:
CLIENT_ORIGIN=http://localhost:3000

# Optional: Live Claude API integration (if omitted, Meetrix uses local intelligent NLP synthesis)
ANTHROPIC_API_KEY=

