# ============================================================
# Meetrix 2.0 — Comprehensive Git Ignore
# ============================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets — NEVER commit real credentials
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Retain example environment templates
!**/.env.example

# Build & Bundler outputs
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# Runtime Data & In-memory server caches
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.mongodb-binaries/
data/
data/db/
temp/
tmp/

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
.jest/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
